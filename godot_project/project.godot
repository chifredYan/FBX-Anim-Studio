; Engine configuration file.
config_version=5

[application]

config/name="fbx_anim_tool"
config/description="FBX skeletal animation extractor: left-facing bone data + 30fps PNG/GIF"
run/main_scene=""

[display]

window/size/viewport_width=64
window/size/viewport_height=64
window/size/window_width_override=64
window/size/window_height_override=64
window/size/resizable=false

[dotnet]

project/assembly_name="fbx_anim_tool"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.09, 0.09, 0.11, 1)